{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iRecall",
  "version": "0.1.0",
  "identifier": "dev.irecall.app",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/server", "binaries/extension", "binaries/node-*"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
